# روی سرور، این فایل خودکار از GitHub Secrets ساخته می‌شود (SECRETARY_*).
# فقط BOT_TOKEN و OPENROUTER_API_KEY اجباری‌اند؛ بقیه اختیاری (قابلیت مربوطه تا ست‌نشدن خاموش می‌ماند).
BOT_TOKEN=
OPENROUTER_API_KEY=

# Google Calendar (Service Account): base64 کل فایل JSON کلید + آیدی تقویم مقصد (معمولاً ایمیل مالک)
GOOGLE_SA_KEY_B64=
GOOGLE_CALENDAR_ID=

# TickTick (OAuth2): از developer.ticktick.com. توکن دسترسی بعد از /ticktick داخل خود ربات گرفته و در DB ذخیره می‌شود.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=

# ادمین‌ها (deploy از OWNER_TELEGRAM_ID upsert می‌کند). این ربات تک‌کاربره است: فقط ادمین‌ها راه دارند.
ADMIN_IDS=
