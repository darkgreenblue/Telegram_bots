  "repair": {
    "system": "You are an editor of a tarot reading written in English.\n\nEvery line you get has one specific problem, named right next to it. Fix only that.\n\nRules:\n- Leave the rest of the line alone. Same length, same tone, same meaning.\n- Spoken and warm, the way a person actually talks. Never corporate, never old fashioned.\n- No long dash, no emoji, no new sentences.\n- Never promise anything as certain; \"most likely\" and \"it leans this way\" are fine.\n\nAnswer with valid JSON only, no code fence:\n{\"fixes\": [\"fixed line 1\", \"fixed line 2\"]}\nSame order, same count.",
    "hints": {
      "evasion": "The decision was handed back to the person. Give a direction: say which side is heavier.",
      "pastTime": "There is a reference to a point in the past, but we do not have the dates of earlier sessions. Drop the time reference itself and keep only the subject."
    },
    "item": "%i) [problem: %hint]\n[the phrase \"%phrase\" must not appear in your answer]\n%text"
  },
  "defects": [
    {
      "id": "llmese",
      "pattern": "\\b(?:delv(?:e|es|ed|ing)\\s+(?:in)?to|tapestry|a\\s+testament\\s+to|it(?:\\s+is|['\\u2019]?s)\\s+(?:important\\s+to\\s+note|worth\\s+noting)|in\\s+the\\s+realm\\s+of|serv(?:e|es)\\s+as\\s+a\\s+(?:reminder|testament)|embark(?:s|ed|ing)?\\s+on\\s+a\\s+journey|navigat(?:e|es|ed|ing)\\s+the\\s+(?:complexities|complexity|landscape|waters|nuances|journey|path|terrain)|multifaceted|myriad\\s+of|plethora\\s+of|underscor(?:e|es|ed|ing)\\s+(?:the|a|an|your|how)|foster(?:s|ed|ing)?\\s+(?:a|an|the|deeper|greater)|unlock(?:s|ed|ing)?\\s+(?:your|the|their)\\s+(?:true\\s+|full\\s+|inner\\s+|hidden\\s+)?potential|profound\\s+(?:sense|impact|shift|transformation|realization|realisation|insight|understanding)|a\\s+journey\\s+of\\s+self[\\s\\-]discovery|intricate\\s+dance|paradigm\\s+shift|ever[\\s\\-]evolving|in\\s+conclusion|i\\s+hope\\s+this\\s+helps)\\b",
      "flags": "i",
      "hint": "This is corporate LLM wording, the kind of phrase no one says out loud. It instantly reads as machine written. Say the same thing the way a person would say it in a normal conversation, with the same length and the same meaning."
    },
    {
      "id": "archaic",
      "pattern": "\\b(?:thee|thou|thy|thine|ye|hath|hast|doth|dost|didst|shalt|mayest|canst|wouldst|shouldst|couldst|verily|forsooth|prithee|methinks|betwixt|thusly|whence|whither|thence|hither|yonder|unto|nay|alas|hark|(?<!lo\\s+and\\s+)behold|o['\\u2019]er|ne['\\u2019]er)\\b|['\\u2019](?:tis|twas|twere|twill)\\b",
      "flags": "i",
      "hint": "Fake old fashioned or mock mystical wording (thee, thou, hath, behold). The reader is a modern person and the voice here is warm and present day. Rewrite it in plain spoken English without losing the meaning."
    },
    {
      "id": "nonlatin",
      "pattern": "[\\u0400-\\u052f\\u0600-\\u06ff\\u0750-\\u077f\\ufb50-\\ufdff\\ufe70-\\ufefc\\u3000-\\u9fff\\uff00-\\uffef]+(?:[ ]+[\\u0400-\\u052f\\u0600-\\u06ff\\u0750-\\u077f\\ufb50-\\ufdff\\ufe70-\\ufefc\\u3000-\\u9fff\\uff00-\\uffef]+)*",
      "flags": "",
      "hint": "There are non Latin characters inside an English text, so the reader sees letters from another alphabet in the middle of the reading. Remove them and write the whole line in English only, card names included."
    },
    {
      "id": "labelleak",
      "pattern": "(?:your|the)\\s+unspoken\\s+feeling",
      "flags": "i",
      "hint": "This names the label instead of writing the feeling. \"Your unspoken feeling is...\" is the internal name of our job, never text for a person. Delete the label and go straight to the feeling itself, for example \"it sounds like you are waiting for someone else to make the call for you\"."
    }
  ],
