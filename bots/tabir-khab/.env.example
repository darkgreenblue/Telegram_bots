# فقط مقادیر محرمانه اینجا قرار می‌گیرند. باقی تنظیمات (مدل‌ها، آدرس‌ها،
# قیمت‌ها، پرسوناها) در config.py داخل کد است. BOT_USERNAME خودکار گرفته می‌شود.

# --- توکن ربات‌ها ---
# معماری: هر زبان یک رباتِ تلگرامِ مستقل (بدون مرحله‌ی انتخاب زبان).
# توکنِ خالی = آن ربات غیرفعال؛ بقیه عادی بالا می‌آیند.

# فارسی — بله (از @botfather در بله)
BALE_BOT_TOKEN=
# فارسی — تلگرام (از @BotFather). نامِ قدیمی TELEGRAM_BOT_TOKEN هم به‌عنوان فالبک پذیرفته می‌شود.
TELEGRAM_BOT_TOKEN_FA=
# سایر زبان‌ها — تلگرام (هر کدام یک ربات جدا از @BotFather)
TELEGRAM_BOT_TOKEN_EN=
TELEGRAM_BOT_TOKEN_AR=
TELEGRAM_BOT_TOKEN_RU=
TELEGRAM_BOT_TOKEN_ES=
TELEGRAM_BOT_TOKEN_PT=

# --- کلیدهای هوش مصنوعی ---
# کلید OpenRouter (همه‌ی LLM: تعبیر متن/صوت + STT)
OPENROUTER_API_KEY=
# کلید GapGPT (فقط تولید تصویر — gapgpt/z-image)
GAPGPT_API_KEY=

# --- پرداخت (اختیاری) ---
# توکن کیف‌پول پرداخت بله از @botfather. خالی = توکن تستِ بله.
BALE_PAYMENT_TOKEN=WALLET-TEST-1111111111111111
# توکن درگاه پرداخت تلگرام (زرین‌پال/Stars) — فعلاً اختیاری
TELEGRAM_PAYMENT_TOKEN=
