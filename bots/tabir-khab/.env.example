# فقط مقادیر محرمانه اینجا قرار می‌گیرند. باقی تنظیمات (مدل‌ها، آدرس‌ها،
# قیمت‌ها، پرسوناها) در config.py داخل کد است. BOT_USERNAME خودکار گرفته می‌شود.

# --- توکن ربات‌ها ---
# توکن ربات بله از @botfather در بله
BALE_BOT_TOKEN=
# توکن ربات تلگرام از @BotFather
TELEGRAM_BOT_TOKEN=

# --- کلیدهای هوش مصنوعی ---
# کلید OpenRouter (همه‌ی LLM: تعبیر متن/صوت + STT)
OPENROUTER_API_KEY=
# کلید GapGPT (فقط تولید تصویر — gapgpt/z-image)
GAPGPT_API_KEY=

# --- پرداخت (اختیاری) ---
# توکن کیف‌پول پرداخت بله از @botfather. خالی = توکن تستِ بله.
BALE_PAYMENT_TOKEN=WALLET-TEST-1111111111111111
# توکن درگاه پرداخت تلگرام (زرین‌پال/Stars) — فعلاً اختیاری
TELEGRAM_PAYMENT_TOKEN=
