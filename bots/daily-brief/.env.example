# روی سرور این فایل خودکار از GitHub Secrets ساخته می‌شود (deploy.yml).
# اجباری:
BOT_TOKEN=
OPENROUTER_API_KEY=
# اختیاری — بدونِ این، ربات بالا می‌آید ولی رودمپِ آموزشی ندارد.
# توکنِ Internal Integration نوشن که پیجِ «دستیار آموزشی» با آن share شده است.
NOTION_TOKEN=
# اختیاری — موتور صدای سوم (تنها موتور با فارسیِ رسماً پشتیبانی‌شده).
# نبودش یعنی فقط موتورهای OpenRouter در لیست و در مقایسه‌ی صداها دیده می‌شوند.
ELEVENLABS_API_KEY=
# ادمین‌ها: deploy از OWNER_TELEGRAM_ID upsert می‌کند. فقط این آی‌دی‌ها به ربات دسترسی دارند.
ADMIN_IDS=
