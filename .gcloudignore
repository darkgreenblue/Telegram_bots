# این فایل هنگام `gcloud run deploy --source .` از ارسال به Cloud Build جلوگیری می‌کند.
# سینتکس شبیه .gitignore است.

# --- Git و محیط ---
.git/
.gitignore
.gcloudignore

# --- اسرار و محیط لوکال ---
.env
.env.*
!.env.example

# --- وابستگی‌ها (روی سرور دوباره با npm ci نصب می‌شود) ---
node_modules/

# --- پایتون (اگر جایی در پروژه باشد) ---
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
*.egg-info/
.eggs/
dist/
build/

# --- IDE و سیستم ---
.DS_Store
.idea/
.vscode/
.cursor/
*.swp
*.swo
*.log
npm-debug.log*

# --- آرتیفکت/باینری سنگین روی دیسک (مثال: دانلود SDK) ---
*.tar.gz
*.zip
*.7z

# --- مدل‌ها / وزن‌ها / دیتاست‌های معمولاً حجیم (هر چه لازم نیست در image) ---
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.bin
*.h5
*.pb
*.tflite
*.mlmodel
*.npz
*.npy

# پوشه‌های رایج دیتا/مدل — در صورت نداشتن، مضر نیستند (ignore خالی)
models/
checkpoints/
weights/
datasets/
data/
raw_data/
extra_data/
local_data/
uploads/
private_assets/

# --- محتوای حساس / مدل‌های خاص — نام دقیق پوشه‌های خودتان را اینجا اضافه کنید ---
# مثال (خطوط زیر را با نام واقعی پوشه‌هایتان جایگزین و از # خارج کنید):
# nsfw_models/
# nude_detector_weights/
# sensitive_media/
